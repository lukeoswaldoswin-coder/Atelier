{
    "name":  "atelier",
    "version":  "0.1.0",
    "private":  true,
    "description":  "Atelier - 面向独立画师的本地委托管理软件",
    "author":  "Atelier",
    "main":  "./out/main/index.js",
    "scripts":  {
                    "dev":  "node scripts/electron-vite.mjs dev",
                    "build":  "electron-vite build",
                    "start":  "node scripts/electron-vite.mjs preview",
                    "typecheck:node":  "tsc --noEmit -p tsconfig.node.json",
                    "typecheck:web":  "tsc --noEmit -p tsconfig.json",
                    "typecheck":  "tsc --noEmit -p tsconfig.node.json \u0026\u0026 tsc --noEmit -p tsconfig.json",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "smoke":  "node scripts/smoke.mjs",
                    "package:dir":  "electron-builder --win --dir",
                    "postinstall":  "node scripts/ensure-electron.mjs",
                    "package:inno":  "node scripts/package-inno.mjs"
                },
    "dependencies":  {
                         "@radix-ui/react-dialog":  "^1.3.1",
                         "@radix-ui/react-slot":  "^1.5.0",
                         "@radix-ui/react-switch":  "^1.4.1",
                         "better-sqlite3":  "13.1.1",
                         "class-variance-authority":  "^0.7.1",
                         "clsx":  "^2.1.1",
                         "koffi":  "^3.3.8",
                         "lucide-react":  "^1.72.0",
                         "react":  "^19.3.1",
                         "react-dom":  "^19.3.1",
                         "tailwind-merge":  "^3.7.0",
                         "zod":  "^4.6.7",
                         "zustand":  "^5.1.0"
                     },
    "devDependencies":  {
                            "@tailwindcss/vite":  "^4.3.5",
                            "@testing-library/dom":  "^10.4.2",
                            "@testing-library/jest-dom":  "^7.0.1",
                            "@testing-library/react":  "^16.3.3",
                            "@testing-library/user-event":  "^14.6.10",
                            "@types/better-sqlite3":  "^9.6.0",
                            "@types/node":  "^26.6.6",
                            "@types/react":  "^19.3.0",
                            "@types/react-dom":  "^19.3.0",
                            "@vitejs/plugin-react":  "^6.3.0",
                            "electron":  "44.7.0",
                            "electron-builder":  "^26.18.0",
                            "electron-vite":  "^6.0.0",
                            "jsdom":  "^31.0.0",
                            "tailwindcss":  "^4.3.5",
                            "typescript":  "^5.9.3",
                            "vite":  "^8.3.8",
                            "vitest":  "^5.1.0"
                        },
    "build":  {
                  "appId":  "com.atelier.desktop",
                  "productName":  "Atelier",
                  "directories":  {
                                      "output":  "dist",
                                      "buildResources":  "build"
                                  },
                  "npmRebuild":  false,
                  "electronDist":  "node_modules/electron/dist",
                  "files":  [
                                "out/**/*",
                                "package.json"
                            ],
                  "asarUnpack":  [
                                     "node_modules/koffi/**",
                                     "node_modules/@koromix/**",
                                     "node_modules/better-sqlite3/**"
                                 ],
                  "win":  {
                              "target":  [
                                             "dir"
                                         ],
                              "icon":  "build/icon.ico",
                              "signExecutable":  false
                          }
              }
}
